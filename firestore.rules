rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all documents by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        userEmail() == 'kirklareliataturkortaokulu@gmail.com' ||
        userEmail() == 'bahadirkumcu@gmail.com'
      );
    }

    function isSchoolAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          (exists(/databases/$(database)/documents/schools/main) && 
           ('admins' in get(/databases/$(database)/documents/schools/main).data) &&
           (userEmail() in get(/databases/$(database)/documents/schools/main).data.admins)) ||
          (exists(/databases/$(database)/documents/schools/main/modules/meta) && 
           ('admins' in get(/databases/$(database)/documents/schools/main/modules/meta).data) &&
           (userEmail() in get(/databases/$(database)/documents/schools/main/modules/meta).data.admins)) ||
          (exists(/databases/$(database)/documents/access_requests/$(userEmail())) && 
           ('role' in get(/databases/$(database)/documents/access_requests/$(userEmail())).data) &&
           (get(/databases/$(database)/documents/access_requests/$(userEmail())).data.role == 'admin'))
        )
      );
    }

    function isSchoolTeacher() {
      return isSchoolAdmin() || (
        isSignedIn() && (
          (exists(/databases/$(database)/documents/schools/main) && 
           ('teachers' in get(/databases/$(database)/documents/schools/main).data) &&
           (userEmail() in get(/databases/$(database)/documents/schools/main).data.teachers)) ||
          (exists(/databases/$(database)/documents/schools/main/modules/meta) && 
           ('teachers' in get(/databases/$(database)/documents/schools/main/modules/meta).data) &&
           (userEmail() in get(/databases/$(database)/documents/schools/main/modules/meta).data.teachers)) ||
          (exists(/databases/$(database)/documents/access_requests/$(userEmail())) && 
           ('role' in get(/databases/$(database)/documents/access_requests/$(userEmail())).data) &&
           (get(/databases/$(database)/documents/access_requests/$(userEmail())).data.role == 'teacher'))
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection test document
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }

    // School collection & data
    match /schools/{schoolId} {
      allow get, list: if isSignedIn();
      allow write: if isSchoolAdmin() || isSuperAdmin();

      // Modular Data Subcollection
      match /modules/{moduleId} {
        allow get, list: if isSignedIn();
        allow write: if isSchoolAdmin() || isSuperAdmin();
      }

      // Cloud Backups subcollection
      match /backups/{backupId} {
        allow get, list: if isSignedIn();
        allow write: if isSchoolAdmin() || isSuperAdmin();
      }
    }

    // Cloud Snapshots (akademi_data.json mirror)
    match /snapshots/{snapshotId} {
      allow get, list: if isSignedIn();
      allow write: if isSchoolAdmin() || isSuperAdmin();
    }

    // Broadcast Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isSchoolTeacher();
      allow update: if isSchoolAdmin() || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
      allow delete: if isSchoolAdmin() || isSuperAdmin();
    }

    // Access Requests & User Registrations
    match /access_requests/{requestId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
