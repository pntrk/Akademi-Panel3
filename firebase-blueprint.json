{
  "entities": {
    "SchoolState": {
      "title": "SchoolState",
      "description": "Comprehensive school state including students, exams, evaluation results, hall placements, and budget",
      "type": "object",
      "properties": {
        "students": {
          "type": "array",
          "description": "List of enrolled students and their registrations"
        },
        "exams": {
          "type": "array",
          "description": "List of scheduled or completed exams"
        },
        "results": {
          "type": "array",
          "description": "Evaluated exam result records"
        },
        "budget": {
          "type": "object",
          "description": "Financial records of incomes, expenses, and debts"
        },
        "examHalls": {
          "type": "array",
          "description": "Exam hall configurations and seating plans"
        },
        "leagueMentors": {
          "type": "object",
          "description": "Mentor teacher assignments for league teams"
        },
        "leagueTeamPoints": {
          "type": "object",
          "description": "Bonus point balances for league teams"
        },
        "approvedTransfers": {
          "type": "array",
          "description": "Approved student team transfers"
        },
        "admins": {
          "type": "array",
          "description": "Authorized administrator email addresses"
        },
        "teachers": {
          "type": "array",
          "description": "Authorized teacher email addresses"
        }
      },
      "required": ["admins"]
    },
    "BackupRecord": {
      "title": "BackupRecord",
      "description": "Cloud snapshot backup of school management data",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique backup identifier",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Human readable backup name",
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of backup creation"
        },
        "createdByEmail": {
          "type": "string",
          "description": "Email of user who triggered the backup",
          "maxLength": 128
        },
        "createdByName": {
          "type": "string",
          "description": "Display name of user",
          "maxLength": 128
        },
        "summary": {
          "type": "object",
          "description": "Statistical summary of backed-up counts"
        },
        "data": {
          "type": "object",
          "description": "Full school state payload"
        },
        "note": {
          "type": "string",
          "description": "Optional notes or tags",
          "maxLength": 500
        }
      },
      "required": ["id", "name", "createdAt", "createdByEmail", "data"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Broadcast notification or announcement for school staff and teachers",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique notification identifier",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Title of the notification",
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "description": "Content message of the notification",
          "maxLength": 2000
        },
        "type": {
          "type": "string",
          "description": "Notification category (e.g. info, exam, urgent)",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO timestamp"
        },
        "createdByEmail": {
          "type": "string",
          "description": "Author email",
          "maxLength": 128
        },
        "createdByName": {
          "type": "string",
          "description": "Author display name",
          "maxLength": 128
        },
        "readBy": {
          "type": "array",
          "description": "List of user emails that acknowledged the notification"
        },
        "linkTab": {
          "type": "string",
          "description": "Optional target navigation tab",
          "maxLength": 50
        }
      },
      "required": ["id", "title", "message", "createdAt"]
    },
    "AccessRequest": {
      "title": "AccessRequest",
      "description": "User account registration and access authorization record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Google email address of registered user",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Display name of user",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar image URL",
          "maxLength": 512
        },
        "role": {
          "type": "string",
          "description": "Current assigned role (admin, teacher, guest)",
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "description": "Membership status (pending, approved, rejected)",
          "maxLength": 32
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Timestamp of last sign-in"
        },
        "timestamp": {
          "type": "string",
          "description": "Initial registration timestamp"
        }
      },
      "required": ["email", "timestamp"]
    }
  },
  "firestore": {
    "/schools/{schoolId}": {
      "schema": "SchoolState",
      "description": "Core state document for a school instance"
    },
    "/schools/{schoolId}/backups/{backupId}": {
      "schema": "BackupRecord",
      "description": "Historical cloud backups and snapshots"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Broadcast notifications and announcements"
    },
    "/access_requests/{requestId}": {
      "schema": "AccessRequest",
      "description": "User access requests for approval by administrator"
    }
  }
}
